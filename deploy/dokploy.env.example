# Paste into Dokploy Environment, or use --env-file deploy/dokploy.env.
# Blank required values deliberately prevent deployment until configured.
# NEW installations only: node deploy/generate-env.mjs --project <exact-project>
# Never regenerate existing DB passwords/encryption keys during redeploy/restore.
# Must match Dokploy's actual Compose project name, including for CLI jobs/volumes.
COMPOSE_PROJECT_NAME=
PKP_DOMAIN=pkp.pkm-ujungpangkah.online
# Real Cloudflare Turnstile keys for the FE hostname; test keys are rejected in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Traefik's actual container IP on dokploy-network. Recheck after recreating it.
TRAEFIK_TRUSTED_PROXY=
# Dedicated frontend -> backend bridge. Change subnet and both IPs together.
PKP_PROXY_SUBNET=172.30.92.0/29
PKP_FRONTEND_PROXY_IP=172.30.92.2
PKP_BACKEND_PROXY_IP=172.30.92.3

POSTGRES_DB=sipkp
POSTGRES_USER=sipkp
POSTGRES_PASSWORD=
# Role+DB created once inside the EXISTING Dokploy PostgreSQL container; no service consumes
# POSTGRES_* anymore, they document the role whose password must match DATABASE_URL.
# postgresql://sipkp:URL_ENCODED_PASSWORD@database-postgresmain-hoc5kd:5432/sipkp?schema=public
DATABASE_URL=
# Optional direct connection to the SAME database/schema using a migration role.
# Empty falls back to DATABASE_URL. Never point this at a different database/schema.
MIGRATION_DATABASE_URL=
REDIS_PASSWORD=
# redis://:URL_ENCODED_PASSWORD@redis:6379
REDIS_URL=
# Generated independently by deploy/generate-env.mjs (64 hex characters).
JWT_SECRET=
# Generator uses 32 random bytes in base64; keep stable and back up separately.
PROVINCE_CREDENTIAL_KEY=

# Required external PRIVATE S3 API, reachable from app and ops containers.
# Set the verified scheme/hostname/port; no public storage domain or console URL.
MINIO_ENDPOINT=
# Dedicated least-privilege runtime account, never the MinIO root account.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Same bucket is supported through evidence/, staging/, and reports/ prefixes.
# Keep existing bucket values on redeploy; changing them requires a separate data migration.
EVIDENCE_BUCKET=pkponline
REPORTS_BUCKET=pkponline

ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=7
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=120

# Only for explicitly approved first-time provisioning; remove after setup.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
