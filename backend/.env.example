NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5175
ENABLE_SWAGGER=false

# Set all blank secrets before starting. URL-encode credentials in DATABASE_URL.
POSTGRES_DB=sipkp
POSTGRES_USER=sipkp
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=postgresql://sipkp:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/sipkp?schema=public
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=
# Required for every province bridge operation: canonical base64 of exactly 32 random bytes.
# Generate securely with: openssl rand -base64 32. Keep stable; back up separately from DB.
PROVINCE_CREDENTIAL_KEY=
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=7
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MINIO_ENDPOINT=http://127.0.0.1:59000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:59000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
EVIDENCE_BUCKET=evidence
REPORTS_BUCKET=reports

# Optional first administrator; credentials are never overwritten by repeat seeding.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Development only. Requires a password of at least 12 characters.
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# Infrastructure: docker compose up -d
# Apply schema explicitly: npm run db:deploy
# Seed only when intentionally setting up demo/development data: npm run db:seed
# Optional container app: docker compose --profile app up -d --build
# Apply migrations from the host before starting the app profile; no automatic seed.
