{
  "name": "sipkp-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json && node --watch dist/src/main.js",
    "prisma:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.e2e.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "bullmq": "^5.60.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "pdfkit": "^0.17.2",
    "playwright": "^1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
